# Generic synthesis of the accelerator with Yosys, tables kept as memories.
# Run from hw/:   yosys -q synth.ys      (or: make synth, which also writes docs/synthesis_yosys.txt)
read_verilog -sv rtl/bitreader.sv rtl/huffman_decoder.sv rtl/huffman_accel_top.sv
hierarchy -check -top huffman_accel_top
proc; flatten; opt
memory -nomap                       # limit/base/symbol tables stay as memory cells
techmap
abc -g AND,NAND,OR,NOR,XOR,XNOR,ANDNOT,ORNOT,MUX   # generic 2-input gates + MUX
opt_clean
tee -o build/stat_nomap.txt stat
tee -o build/ltp.txt ltp -noff     # paths stop at flip-flops: the real combinational depth
# ---- the alternative the report argues against: the same tables flattened into logic
design -reset
read_verilog -sv rtl/bitreader.sv rtl/huffman_decoder.sv rtl/huffman_accel_top.sv
hierarchy -check -top huffman_accel_top
proc; flatten; opt
memory_map                          # tables become registers + muxes
opt; techmap
abc -g AND,NAND,OR,NOR,XOR,XNOR,ANDNOT,ORNOT,MUX
opt_clean
tee -o build/stat_flat.txt stat
